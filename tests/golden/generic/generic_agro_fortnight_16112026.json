          "text": "ในระยะครึ่งหลังของเดือนพฤศจิกายน บริเวณความกดอากาศสูงจากประเทศจีนจะแผ่ลงมาปกคลุมประเทศไทยตอนบนเป็นระลอกๆ",
          "uncertain": false,
          "unit_id": "g-22685216"
        },
        {
          "confidence": 1.0,
          "dates": [],
          "label": "cause",
          "numbers": [],
          "provinces": [],
          "regions": [
            "north",
            "northeast",
            "central",
            "east",
            "south_east_coast",
            "south_west_coast",
            "bangkok_vicinity"
          ],
          "text": "ประกอบกับมรสุมตะวันออกเฉียงเหนือพัดปกคลุมบริเวณประเทศไทยและอ่าวไทย และมีร่องมรสุมพาดผ่านบริเวณภาคใต้ในบางช่วง ลักษณะดังกล่าวทำให้บริเวณประเทศไทยตอนบนมีฝนลดลง แต่ยังมีฝนในบางพื้นที่กับมีอากาศเย็นในตอนเช้าบริเวณภาคเหนือและภาคตะวันออกเฉียงเหนือ",
          "uncertain": false,
          "unit_id": "g-29eb19d2"
        },
        {
          "confidence": 0.9999,
          "dates": [],
          "label": "weather",
          "numbers": [],
          "provinces": [
            "ชุมพร"
          ],
          "regions": [
            "south_east_coast",
            "south_west_coast"
          ],
          "text": "ส่วนภาคใต้ยังคงมีฝนตกหนาแน่น โดยเฉพาะทางฝั่งตะวันออกตั้งแต่จังหวัดชุมพรลงไป ซึ่งอาจทำให้เกิดสภาวะน้ำท่วม",
          "uncertain": false,
          "unit_id": "g-f427b0fd"
        },
        {
          "confidence": 0.9989,
          "dates": [],
          "label": "weather",
          "numbers": [
            "2 - 3 เมตร",
            "1 - 2 เมตร"
          ],
          "provinces": [],
          "regions": [
            "east",
            "south_east_coast",
            "south_west_coast"
          ],
          "text": "อนึ่ง คลื่นลมบริเวณอ่าวไทยจะมีกำลังแรง โดยจะคลื่นสูง 2 - 3 เมตร ในบางช่วง ส่วนทะเลอันดามันจะมีคลื่นสูง 1 - 2 เมตร",
          "uncertain": false,
          "unit_id": "g-e2436461"
        },
        {
          "confidence": 1.0,
          "dates": [],
          "label": "other",
          "numbers": [],
          "provinces": [],
          "regions": [],
          "text": "ในระยะครึ่งหลังของเดือนนี้มักมีหย่อมความกดอากาศต่ำกำลังแรงหรือพายุหมุนเขตร้อนบริเวณทะเลจีนใต้ตอนล่าง ซึ่งอาจเคลื่อนตัวเข้าใกล้ประเทศไทย ทำให้หลายพื้นที่มีฝนตกชุกและฝนตกหนักในบางแห่ง เกษตรกรควรระวังอันตรายและป้องกันความสียหายจากสภาวะดังกล่าว โดยติดตามพยากรณ์อากาศ พยากรณ์อากาศเกษตร และประกาศกรมอุตุนิยมวิทยา จากกรมอุตุนิยมวิทยาอย่างใกล้ชิด",
          "uncertain": false,
          "unit_id": "g-2ddce0b7"
        },
        {
          "confidence": 0.9966,
          "dates": [],
          "label": "other",
          "numbers": [],
          "provinces": [],
          "regions": [
            "north",
            "northeast",
            "central",
            "east",
            "bangkok_vicinity"
          ],
          "text": "ระยะนี้บริเวณประเทศไทยตอนบนเป็นช่วงฤดูหนาว โดยภาคเหนือและภาคตะวันออกเฉียงเหนือตอนบนจะมีอากาศหนาวเย็นกว่าบริเวณอื่น เกษตรกรควรให้ความอบอุ่นแก่ตนเอง อย่างเพียงพอและดูแลรักษาสุขภาพให้แข็งแรงเพื่อป้องกันการเจ็บป่วย รวมทั้งระวังโรคที่เกี่ยวกับระบบทางเดินหายใจ",
          "uncertain": false,
          "unit_id": "g-bf07bff8"
        },
        {
          "confidence": 1.0,
          "dates": [],
          "label": "advice",
          "numbers": [],
          "provinces": [],
          "regions": [
            "south_east_coast",
            "south_west_coast"
          ],
          "text": "อนึ่ง พื้นที่การเกษตรที่อยู่นอกเขตชลประทานเกษตรกรควรปลูกพืชที่อายุการเก็บเกี่ยวสั้นและใช้น้ำน้อย สำหรับภาคใต้จะมีฝนตกชุกกับมีฝนตกหนักถึงหนักมากบางพื้นที่ เกษตรกรควรระวังอันตรายและป้องกันความเสียหายจากสภาวะน้ำท่วมฉับพลัน น้ำป่าไหลหลาก",
          "uncertain": false,
          "unit_id": "g-d74d1f7f"
        },
        {
          "confidence": 0.9518,
          "dates": [],
          "label": "cause",
          "numbers": [],
          "provinces": [],
          "regions": [
            "east",
            "south_east_coast"
          ],
          "text": "อนึ่ง ในช่วงที่มรสุมตะวันออกเฉียงเหนือมีกำลังแรง คลื่นลมบริเวณอ่าวไทยจะมีกำลังแรงขึ้น ชาวเรือและชาวประมงควรเพิ่มความระมัดระวังในการเดินเรือ",
          "uncertain": false,
          "unit_id": "g-4b974cb8"
        },
        {
          "confidence": 1.0,
          "dates": [],
          "label": "advice",
          "numbers": [],
          "provinces": [],
          "regions": [],
          "text": "สัตว์เลี้ยง เกษตรกรควรควบคุมอุณหภูมิภายในโรงเรือนเลี้ยงสัตว์อย่าให้เปลี่ยนแปลงรวดเร็ว เพื่อป้องกันสัตว์เลี้ยงปรับตัวไม่ทัน อ่อนแอ และเป็นโรคได้ง่าย รวมทั้งควรจัดทำแผงกำบังลมหนาว โดยเฉพาะสัตว์ที่ยังเล็กควรเพิ่มความอบอุ่นภายในโรงเรือนเลี้ยงสัตว์ และควรหมั่นสังเกตหากพบตัวที่เป็นโรคควรรีบแยกออกจากกลุ่ม เพื่อป้องกันเชื้อโรคแพร่ไปยังตัวอื่นๆ",
          "uncertain": true,
          "unit_id": "g-aa0ab7eb"
        },
        {
          "confidence": 0.8292,
          "dates": [],
          "label": "advice",
          "numbers": [],
          "provinces": [],
          "regions": [],
          "text": "สัตว์น้ำ เกษตรกรควรดูแลสภาพน้ำให้เหมาะสมกับสัตว์น้ำที่เลี้ยง รวมทั้งควรลดปริมาณอาหาร เนื่องอุณหภูมิที่ลดลงทำให้สัตว์น้ำกินอาหารน้อยลง อาหารที่เหลือจะทำให้น้ำเน่าเสีย",
          "uncertain": true,
          "unit_id": "g-1e7dfba6"
        },
        {
          "confidence": 0.9995,
          "dates": [],
          "label": "advice",
          "numbers": [],
          "provinces": [],
          "regions": [],
          "text": "อนึ่ง ในช่วงที่คลื่นลมมีกำลังแรง ผู้ที่เลี้ยงสัตว์น้ำชายฝั่ง ควรระวังและป้องกันความเสียหาย ที่อาจเกิดขึ้น หากสัตว์น้ำโตได้ขนาด ควรทยอยจับขายไปก่อนบางส่วนเพื่อลดความเสี่ยง",
          "uncertain": false,
          "unit_id": "g-45e9eae8"
        },
        {
          "confidence": 0.9906,
          "dates": [],
          "label": "weather",
          "numbers": [],
          "provinces": [],
          "regions": [
            "north",
            "northeast",
            "central",
            "east",
            "bangkok_vicinity"
          ],
          "text": "ไม้ผล บริเวณประเทศไทยตอนบน ไม้ผลที่ออกดอกในช่วงฤดูหนาว เช่น ลำไยและลิ้นจี่ เป็นต้น เกษตรกรควรกำจัดวัชพืชบริเวณโคนต้นให้โล่งเตียน ดินบริเวณโคนต้นแห้ง เมื่อมีอุณหภูมิลดลงจนอากาศหนาวเย็นเพียงพอและยาวนานที่เหมาะสมก็จะกระตุ้นให้พืชแตกตาดอกได้ดีขึ้น",
          "uncertain": true,
