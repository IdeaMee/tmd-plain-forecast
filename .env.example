# คัดลอกเป็น .env แล้วใส่ค่าจริงบนเครื่อง (.env อยู่ใน .gitignore) ห้ามวางค่าจริงในแชทหรือใน repo
# ห้ามตั้งชื่อ secret ขึ้นต้นด้วย NEXT_PUBLIC_

# Neon: role อ่านอย่างเดียว แบบ pooled (เว็บบน Vercel ใช้ตัวนี้)
DATABASE_URL=
# Neon: role เจ้าของ แบบ direct (ใช้เฉพาะสคริปต์โหลดข้อมูลบนเครื่องทีม ห้ามใส่ใน Vercel)
DATABASE_URL_DIRECT=
# ความลับของ route ล้างแคช /internal/revalidate (ใส่ทั้งบน Vercel และเครื่องที่รันสคริปต์โหลด)
REVALIDATE_SECRET=
# ที่อยู่เว็บที่สคริปต์โหลดจะเรียกล้างแคช เช่น https://tmd-plain-forecast.vercel.app (ไม่ใช่ความลับ)
SITE_URL=

# ฟังก์ชัน Python บน Vercel (PyThaiNLP ห้ามดาวน์โหลดข้อมูลเพิ่ม และต้องใช้โฟลเดอร์ที่เขียนได้)
# api/summarize.py ตั้งค่าสองตัวนี้ในโค้ดเองแล้ว ไม่ต้องใส่ใน Vercel (ใส่ไว้ใช้ตอนรันบนเครื่อง)
PYTHAINLP_READ_ONLY=1
PYTHAINLP_DATA=/tmp/pythainlp-data

# ไม่บังคับ: โฟลเดอร์ JSON สำรองเมื่อไม่ตั้ง DATABASE_URL (ค่าเริ่มต้น data/processed; e2e ใช้ชี้ไปข้อมูลว่าง/เสีย)
# FORECAST_DATA_DIR=
# ไม่บังคับ: เว็บที่ npm run smoke ทดสอบ (ค่าเริ่มต้น https://tmd-plain-forecast.vercel.app)
# SMOKE_URL=
